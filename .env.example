# Copy this file to .env and fill in your key. Never commit .env to GitHub.
OLLAMA_API_KEY=
PORT=8080

# Optional: "Turn on PC" button. A secret link that runs an Alexa routine turning the PC's smart plug on
# (e.g. from Voice Monkey or Virtual Smart Home), and a PIN of at least 6 digits the website asks for.
POWER_ON_URL=
POWER_PIN=
