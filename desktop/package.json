{
  "name": "albatross-desktop",
  "productName": "Albatross",
  "version": "1.0.0",
  "description": "Albatross as a Windows app: your own AI, with the host and Ollama started by itself",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "node prepare.js && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.albatross.desktop",
    "productName": "Albatross",
    "directories": { "output": "dist" },
    "files": ["main.js", "splash.html", "icon.png"],
    "extraResources": [{ "from": "bundle", "to": "albatross" }],
    "win": { "target": "nsis", "icon": "icon.png" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Albatross",
      "runAfterFinish": true
    }
  }
}
