{
  "manifest_version": 3,
  "name": "Albatross Agent",
  "version": "1.0.0",
  "description": "Lets the Albatross Agent on this PC use this Chrome: it opens pages, reads them and clicks or types in a tab of its own.",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Albatross Agent", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
