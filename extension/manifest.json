{
  "manifest_version": 3,
  "name": "Albatross",
  "version": "1.3.0",
  "description": "Albatross in a Chrome sidebar: chat with your own AI about the page you're on, and let it read, click and type there for you.",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms", "sidePanel", "clipboardRead"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Albatross", "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" } },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
